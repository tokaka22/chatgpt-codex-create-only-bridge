new file mode 100644
index 0000000..2e23a67
--- /dev/null
+++ b/src/namedPermissionProfile.ts
@@ -0,0 +1,68 @@
+import { realpathSync, statSync } from "node:fs";
+import path from "node:path";
+
+/** Operator-owned constraints; never part of the public task input schema. */
+export type NamedPermissionConstraints = { permissionProfile?: string; expectedWritableRoots?: string[] };
+
+export function canonicalPermissionRoot(value: string): string {
+  if (!path.isAbsolute(value) || !statSync(value).isDirectory()) throw new Error("Expected an existing absolute directory.");
+  const canonical = realpathSync(value);
+  if (canonical === path.parse(canonical).root) throw new Error("The filesystem root cannot be a named-profile output directory.");
+  return canonical;
+}
+
+export function parseNamedPermissionConstraints(profile: string | undefined, roots: string | undefined): NamedPermissionConstraints {
+  if (!profile && !roots) return {};
+  if (!profile || !/^[A-Za-z][A-Za-z0-9_-]{0,63}$/.test(profile) || !roots) {
+    throw new Error("DEFAULT_PERMISSION_PROFILE and EXPECTED_WRITABLE_ROOTS must be configured together with a named profile and a JSON array of absolute output directories.");
+  }
+  try {
+    const parsed: unknown = JSON.parse(roots);
+    if (!Array.isArray(parsed) || !parsed.length || parsed.length > 16 || parsed.some(root => typeof root !== "string")) throw new Error();
+    const expectedWritableRoots = parsed.map(root => canonicalPermissionRoot(root as string));
+    if (new Set(expectedWritableRoots).size !== expectedWritableRoots.length) throw new Error();
+    return { permissionProfile: profile, expectedWritableRoots };
+  } catch {
+    throw new Error("EXPECTED_WRITABLE_ROOTS must be a nonempty JSON array of distinct existing absolute output directories, excluding the filesystem root.");
+  }
+}
+
+export function requireNamedProfileCwd(access: NamedPermissionConstraints & { cwd: string }): void {
+  if (!access.permissionProfile) return;
+  const roots = access.expectedWritableRoots;
+  if (!roots?.length || !roots.includes(canonicalPermissionRoot(access.cwd))) {
+    throw new Error("PERMISSION_PROFILE_POLICY_CONFLICT: Start fresh work in an explicitly configured output directory. Historical project roots remain readable history, not execution targets.");
+  }
+}
+
+/** config/read is authoritative for the complete named profile. The legacy
+ * sandbox projection can omit the cwd and cannot represent read carveouts. */
+export function verifyNamedPermissionConfig(config: unknown, access: NamedPermissionConstraints & { cwd: string }): void {
+  if (!access.permissionProfile) return;
+  requireNamedProfileCwd(access);
+  const fail = () => new Error("PERMISSION_PROFILE_CONFIG_MISMATCH: The effective profile is not a verified read-only base with only the operator's explicit output directories writable. No turn was started.");
+  if (!record(config) || config.default_permissions !== access.permissionProfile || !record(config.permissions)) throw fail();
+  const profile = config.permissions[access.permissionProfile];
+  if (!record(profile) || profile.extends !== ":read-only" || !record(profile.filesystem) || !record(profile.network) || profile.network.enabled !== false) throw fail();
+  if (Object.keys(profile).some(key => !["description", "extends", "filesystem", "network", "workspace_roots"].includes(key))) throw fail();
+  if (profile.workspace_roots != null && (!record(profile.workspace_roots) || Object.values(profile.workspace_roots).some(value => value !== false))) throw fail();
+  // Keep this first supported subset deliberately small. Additional grants,
+  // inheritance, scoped tables, and socket permissions require separate review.
+  if (Object.entries(profile.network).some(([key, value]) => key !== "enabled" && value != null && value !== false)) throw fail();
+  const writes = new Set<string>();
+  for (const [location, mode] of Object.entries(profile.filesystem)) {
+    if (location === "glob_scan_max_depth" && (mode == null || Number.isSafeInteger(mode))) continue;
+    if (mode === "read" || mode === "deny") continue;
+    if (mode !== "write") throw fail();
+    try {
+      const root = canonicalPermissionRoot(location);
+      if (!access.expectedWritableRoots!.includes(root)) throw fail();
+      writes.add(root);
+    } catch { throw fail(); }
+  }
+  if (writes.size !== access.expectedWritableRoots!.length || access.expectedWritableRoots!.some(root => !writes.has(root))) throw fail();
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
