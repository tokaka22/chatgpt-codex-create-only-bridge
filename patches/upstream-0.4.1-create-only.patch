+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { loadConfig } from "../src/config.js";
+import { resolveExecutionPolicy } from "../src/executionPolicy.js";
+import { executionAccessArguments, threadAccessParams, verifyExecutionAccess } from "../src/executionAccess.js";
+import { verifyNamedPermissionConfig } from "../src/namedPermissionProfile.js";
+import { UserSettingsStore } from "../src/userSettings.js";
+import { CodexAppServerUpstreamPool } from "../src/appServerUpstream.js";
+
+function fixture() {
+  const directory = realpathSync(mkdtempSync(path.join(tmpdir(), "named-output-policy-")));
+  const cwd = path.join(directory, "output"), original = path.join(directory, "original");
+  mkdirSync(cwd); mkdirSync(original);
+  const profile = "isolated-output";
+  const environment = { CODEX_MCP_BRIDGE_NO_AUTH: "1", CODEX_MCP_BRIDGE_ALLOW_WRITE: "1",
+    CODEX_MCP_BRIDGE_DEFAULT_SANDBOX: "workspace-write", CODEX_MCP_BRIDGE_APPROVAL_POLICY: "never",
+    CODEX_MCP_BRIDGE_DEFAULT_PERMISSION_PROFILE: profile, CODEX_MCP_BRIDGE_EXPECTED_WRITABLE_ROOTS: JSON.stringify([cwd]) };
+  const config = loadConfig(environment);
+  const access = resolveExecutionPolicy(config, { accessStrategy: "adaptive" }, cwd);
+  const effective = { default_permissions: profile, permissions: { [profile]: { extends: ":read-only", description: null,
+    workspace_roots: null, filesystem: { glob_scan_max_depth: null, [original]: "read", [cwd]: "write" },
+    network: { enabled: false, domains: null, unix_sockets: null } } } };
+  return { directory, cwd, original, profile, environment, config, access, effective };
+}
+
+function cleanup(directory: string) { rmSync(directory, { recursive: true, force: true }); }
