new file mode 100644
index 0000000..8d2e060
--- /dev/null
+++ b/docs/named-output-permissions.md
@@ -0,0 +1,41 @@
+# Operator-owned output directory permissions
+
+This optional policy keeps existing projects readable while restricting persistent command writes to explicit new output directories. It does not expose permission controls in `codex_task`. Keep the original project registry, ROOTS ceiling, database, and conversation scopes so historical jobs remain queryable. Old project execution targets fail closed; select a fresh output project.
+
+The bridge requires both operator environment variables:
+
+```sh
+CODEX_MCP_BRIDGE_DEFAULT_PERMISSION_PROFILE=example-project-full-example-version
+CODEX_MCP_BRIDGE_EXPECTED_WRITABLE_ROOTS='["/Users/example/KD/ExampleProject-RSI-full-example-version"]'
+CODEX_MCP_BRIDGE_DEFAULT_SANDBOX=workspace-write
+CODEX_MCP_BRIDGE_ALLOW_WRITE=1
+CODEX_MCP_BRIDGE_ALLOW_DANGER_FULL_ACCESS=0
+CODEX_MCP_BRIDGE_APPROVAL_POLICY=never
+```
+
+Create and register the output directory before starting the replacement bridge. Its canonical absolute path must match the requested cwd exactly. These settings are included in the execution envelope fingerprint. They do not alter the historical allowed-root registry.
+
+Use a new operator-owned launcher wrapping the fixed CLI, without editing the existing Codex home or project configuration. Pass these arguments before the forwarded CLI arguments:
+
+```sh
+exec /opt/homebrew/bin/node /Users/example/Apps/codex-mcp-bridge-runtime/node_modules/.bin/codex \
+  -c 'default_permissions="example-project-full-example-version"' \
+  -c 'permissions.example-project-full-example-version={ extends = ":read-only", filesystem = { "/Users/example/KD/ExampleProject" = "read", "/Users/example/KD/ExampleProject-RSI-full-example-version" = "write" }, network = { enabled = false } }' \
+  "$@"
+```
+
+Point `CODEX_MCP_BRIDGE_CODEX` to that new executable launcher. The operator owns this wrapper and the environment; task prompts cannot supply CLI `-c` overrides. Keep the old service stopped only when ready to replace it, retaining its files for rollback. A configuration change does not resolve an already pending approval.
+
+Before every fresh/continued/forked model turn, the adapter reads the effective configuration with `config/read` for that cwd. The supported initial subset requires an explicit matching `default_permissions`, `extends=":read-only"`, exact absolute `write` rules matching the operator list, disabled networking, and no extra workspace roots, nested grants, named parents, or socket grants. Unsupported or broader policies fail before a model turn. Runtime policy evidence must confirm the exact profile ID, cwd, never/on-request policy selected by the operator, disabled network, no global temporary write grant, and no unexpected roots in the legacy projection. New threads send `permissions` without `sandbox`; subsequent turns preserve that profile ID without reconstructing it from the projection.
+
+The fixed CLI 0.153.3 omits cwd writes from legacy `sandbox.writableRoots`; an empty array alone is not proof of read-only access. Full profile configuration is the write-boundary authority. For continuation, the original context is resumed without permission overrides and checked before any turn; a different or legacy profile is not silently migrated.
+
+`never` returns sandbox failures directly; it does not grant escalation. Commands needing unsupported browser/system privileges can still fail. Existing files inside the new output directory can be revised; files in the original project remain read-only. This is directory isolation, not per-file append-only semantics.
+
+Optional real macOS verification, with zero model turns and an isolated temporary CODEX_HOME:
+
+```sh
+./node_modules/.bin/tsx scripts/verify-named-output-profile.ts /Users/example/Apps/codex-mcp-bridge-runtime/node_modules/.bin/codex
+```
+
+The check uses `codex sandbox -P ... -C ... -- ...`, never `thread/shellCommand`. It tests reading original fixture files, creating output, denied overwrite/delete/outside writes, and denied symlink escape; it also checks actual config/read and thread/start policy responses. The retained fixture path contains evidence. It does not modify the real project, existing configuration, credentials, bridge state, or active jobs.
diff --git a/scripts/verify-named-output-profile.ts b/scripts/verify-named-output-profile.ts
new file mode 100644
index 0000000..9db70bf
--- /dev/null
+++ b/scripts/verify-named-output-profile.ts
@@ -0,0 +1,77 @@
+/** Optional no-LLM macOS smoke check. All canaries/config/state are new files
+ * in a retained temporary fixture. Never use thread/shellCommand as a sandbox. */
+import assert from "node:assert/strict";
+import { spawn, spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import readline from "node:readline";
+import { verifyNamedPermissionConfig } from "../src/namedPermissionProfile.js";
+import { verifyExecutionAccess } from "../src/executionAccess.js";
+
+const cli = process.argv[2];
+if (process.platform !== "darwin" || !cli || !path.isAbsolute(cli)) throw new Error("Usage on macOS: tsx scripts/verify-named-output-profile.ts /absolute/path/to/codex");
+const root = realpathSync(mkdtempSync(path.join(tmpdir(), "bridge-output-profile-smoke-")));
+const home = path.join(root, "home"), original = path.join(root, "original"), output = path.join(root, "output"), outside = path.join(root, "outside");
+for (const directory of [home, original, output, outside]) mkdirSync(directory);
+writeFileSync(path.join(original, "keep.txt"), "original");
+writeFileSync(path.join(original, "remove.txt"), "preserve");
+symlinkSync(original, path.join(output, "old-link"));
+const profile = "bridge-output-fixture";
+const profileDefinition = `{ extends = ":read-only", filesystem = { ${JSON.stringify(original)} = "read", ${JSON.stringify(output)} = "write" }, network = { enabled = false } }`;
+const overrides = ["-c", `default_permissions=${JSON.stringify(profile)}`, "-c", `permissions.${profile}=${profileDefinition}`, "-c", 'approval_policy="never"'];
+const environment = { PATH: process.env.PATH!, HOME: home, CODEX_HOME: home, TMPDIR: outside };
+const check = `const fs = require("node:fs"), path = require("node:path"), assert = require("node:assert/strict");
+const [old, output, outside] = process.argv.slice(1);
+assert.equal(fs.readFileSync(path.join(old,"keep.txt"),"utf8"),"original");
+fs.writeFileSync(path.join(output,"new.txt"),"new");
+for (const action of [()=>fs.writeFileSync(path.join(old,"keep.txt"),"changed"),()=>fs.unlinkSync(path.join(old,"remove.txt")),()=>fs.writeFileSync(path.join(outside,"escape.txt"),"changed"),()=>fs.writeFileSync(path.join(output,"old-link","keep.txt"),"changed")]) {
+assert.throws(action, error=>error.code==="EPERM"||error.code==="EACCES");
+}
+console.log(JSON.stringify({readOld:true,writeNew:true,overwriteOld:"denied",deleteOld:"denied",writeOutside:"denied",symlinkEscape:"denied"}));`;
+const sandbox = spawnSync(cli, [...overrides, "sandbox", "-P", profile, "-C", output, "--", process.execPath, "-e", check, original, output, outside],
+  { cwd: output, env: environment, encoding: "utf8", timeout: 30_000 });
+writeFileSync(path.join(root, "sandbox-evidence.json"), JSON.stringify({ status: sandbox.status, stdout: sandbox.stdout, stderr: sandbox.stderr }, null, 2));
+assert.equal(sandbox.status, 0, sandbox.stderr || sandbox.stdout || String(sandbox.error));
+assert.equal(readFileSync(path.join(original, "keep.txt"), "utf8"), "original");
+assert.equal(readFileSync(path.join(original, "remove.txt"), "utf8"), "preserve");
+
+const child = spawn(cli, [...overrides, "app-server", "--listen", "stdio://"], { cwd: output, env: environment, stdio: ["pipe", "pipe", "pipe"] });
+const pending = new Map<number, { resolve(value: any): void; reject(error: Error): void; timer: ReturnType<typeof setTimeout> }>();
+let sequence = 0, approvalRequests = 0;
+const lines = readline.createInterface({ input: child.stdout });
+lines.on("line", line => {
+  const message = JSON.parse(line);
+  if (message.method && message.id !== undefined) { approvalRequests += 1; return; }
+  const request = pending.get(message.id);
+  if (!request) return;
+  clearTimeout(request.timer); pending.delete(message.id);
+  if (message.error) request.reject(new Error(JSON.stringify(message.error))); else request.resolve(message.result);
+});
+child.stderr.resume();
+function request(method: string, params: unknown): Promise<any> {
+  return new Promise((resolve, reject) => {
+    const id = ++sequence, timer = setTimeout(() => { pending.delete(id); reject(new Error(`Timed out: ${method}`)); }, 20_000);
+    pending.set(id, { resolve, reject, timer }); child.stdin.write(JSON.stringify({ id, method, params }) + "\n");
+  });
+}
+try {
+  await request("initialize", { clientInfo: { name: "isolated-output-smoke", version: "1" }, capabilities: { experimentalApi: true } });
+  child.stdin.write('{"method":"initialized"}\n');
+  const access = { cwd: output, sandbox: "workspace-write" as const, approvalPolicy: "never" as const, approvalsReviewer: "user" as const,
+    permissionProfile: profile, expectedWritableRoots: [output] };
+  const config = await request("config/read", { cwd: output, includeLayers: false });
+  verifyNamedPermissionConfig(config.config, access);
+  const result = await request("thread/start", { cwd: output, runtimeWorkspaceRoots: [output], permissions: profile, approvalPolicy: "never", approvalsReviewer: "user", ephemeral: true, experimentalRawEvents: false });
+  verifyExecutionAccess(result, access, "thread/start");
+  assert.equal(approvalRequests, 0);
+  writeFileSync(path.join(root, "policy-evidence.json"), JSON.stringify({ activePermissionProfile: result.activePermissionProfile, sandbox: result.sandbox,
+    config: { default_permissions: config.config.default_permissions, permissions: config.config.permissions }, approvalRequests, modelTurnsStarted: 0 }, null, 2));
+  console.log(JSON.stringify({ fixture: root, sandbox: JSON.parse(sandbox.stdout), profileVerified: true, approvalRequests, modelTurnsStarted: 0 }));
+} finally {
+  for (const item of pending.values()) clearTimeout(item.timer);
+  child.stdin.end();
+  const timer = setTimeout(() => child.kill("SIGTERM"), 3_000);
+  await new Promise<void>(resolve => child.once("exit", () => resolve()));
+  clearTimeout(timer); lines.close();
+}
